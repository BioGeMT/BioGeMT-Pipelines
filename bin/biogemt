#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_FILE="${BIOGEMT_CONFIG:-${ROOT_DIR}/config/server.env}"

BIOGEMT_ROOT="${BIOGEMT_ROOT:-/srv/biogemt}"
BIOGEMT_DATA="${BIOGEMT_DATA:-${BIOGEMT_ROOT}/data}"
BIOGEMT_RUNS="${BIOGEMT_RUNS:-${BIOGEMT_ROOT}/runs}"

if [[ -f "${CONFIG_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${CONFIG_FILE}"
fi

export BIOGEMT_ROOT BIOGEMT_DATA BIOGEMT_RUNS

usage() {
  cat <<USAGE
Usage:
  biogemt list
  biogemt run genomic-region-annotator [args...]
  biogemt doctor
USAGE
}

command="${1:-}"
case "${command}" in
  list)
    echo "genomic-region-annotator"
    ;;
  run)
    pipeline="${2:-}"
    if [[ -z "${pipeline}" ]]; then
      usage >&2
      exit 2
    fi
    shift 2
    case "${pipeline}" in
      genomic-region-annotator)
        exec "${ROOT_DIR}/pipelines/genomic-region-annotator/run.sh" "$@"
        ;;
      *)
        echo "Unknown pipeline: ${pipeline}" >&2
        exit 2
        ;;
    esac
    ;;
  doctor)
    exec "${ROOT_DIR}/scripts/doctor.sh"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "Unknown command: ${command}" >&2
    usage >&2
    exit 2
    ;;
esac
