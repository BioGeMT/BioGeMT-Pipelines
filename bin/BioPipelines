#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -h "${SOURCE}" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "${SOURCE}")" >/dev/null 2>&1 && pwd)"
  TARGET="$(readlink "${SOURCE}")"
  if [[ "${TARGET}" == /* ]]; then
    SOURCE="${TARGET}"
  else
    SOURCE="${SOURCE_DIR}/${TARGET}"
  fi
done
ROOT_DIR="$(cd -P "$(dirname "${SOURCE}")/.." >/dev/null 2>&1 && pwd)"
CONFIG_FILE="${BIOGEMT_CONFIG:-${ROOT_DIR}/config/server.env}"

if [[ -f "${CONFIG_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${CONFIG_FILE}"
fi

BIOGEMT_ROOT="${BIOGEMT_ROOT:-/srv/biogemt}"
BIOGEMT_DATA="${BIOGEMT_DATA:-${BIOGEMT_ROOT}/data}"

export BIOGEMT_ROOT BIOGEMT_DATA

usage() {
  cat <<USAGE
Usage:
  BioPipelines list
  BioPipelines run genomic-region-annotator [args...]
  BioPipelines doctor
USAGE
}

command="${1:-}"
case "${command}" in
  list)
    printf 'Available pipelines:\n\n'
    printf '  %-28s %s\n' \
      'genomic-region-annotator' \
      'Annotates genomic intervals using Ensembl GTF data.'
    printf '    Usage: %s\n' \
      'https://github.com/BioGeMT/genomic_region_annotator#usage'
    printf '\nRun a pipeline with: BioPipelines run <name> <command> [options]\n'
    ;;
  run)
    pipeline="${2:-}"
    if [[ -z "${pipeline}" ]]; then
      usage >&2
      exit 2
    fi
    shift 2
    case "${pipeline}" in
      genomic-region-annotator)
        exec "${ROOT_DIR}/pipelines/genomic-region-annotator/run.sh" "$@"
        ;;
      *)
        echo "Unknown pipeline: ${pipeline}" >&2
        exit 2
        ;;
    esac
    ;;
  doctor)
    exec "${ROOT_DIR}/scripts/doctor.sh"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "Unknown command: ${command}" >&2
    usage >&2
    exit 2
    ;;
esac
