# Copy this file to config/server.env for server-specific overrides.
# Do not commit config/server.env.

BIOGEMT_ROOT=/srv/biogemt

PIPELINES_DIR=/srv/biogemt/pipelines
DATA_DIR=/srv/biogemt/data
RUNS_DIR=/srv/biogemt/runs
LOGS_DIR=/srv/biogemt/logs

PIPELINE_REPOSITORY=https://github.com/BioGeMT/genomic_region_annotator.git
PIPELINE_COMMAND=genomic-region-annotator
